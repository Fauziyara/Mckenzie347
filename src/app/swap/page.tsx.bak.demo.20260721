"use client";

import { useEffect, useMemo, useState } from "react";
import { Header } from "@/components/header";
import { Footer } from "@/components/footer";
import { mockPairs } from "@/lib/mock-data";
import { formatUsd, formatPrice, formatNumber } from "@/lib/format";

interface Holding {
  id: string;
  symbol: string;
  name: string;
  amount: number;
  price: number;
  valueUsd: number;
  change24h: number;
  pairAddress: string;
  avgBuy: number;
  pnlUsd: number;
  pnlPct: number;
}

const PORTFOLIO_KEY = "aperture-portfolio";
const STABLES = new Set(["USDC", "USDT", "DAI"]);

function recompute(h: Holding, amount: number, price: number, avgBuy: number): Holding {
  const valueUsd = amount * price;
  const cost = amount * avgBuy;
  const pnlUsd = valueUsd - cost;
  const pnlPct = cost > 0 ? (pnlUsd / cost) * 100 : 0;
  return { ...h, amount, price, avgBuy, valueUsd, pnlUsd, pnlPct };
}

function bestPairPrice(symbol: string): { price: number; pair: (typeof mockPairs)[number] | null } {
  if (STABLES.has(symbol)) return { price: 1, pair: null };
  // Prefer pairs vs USDC with sane price range
  const candidates = mockPairs.filter((p) => p.token0.symbol === symbol);
  if (candidates.length === 0) {
    const any = mockPairs.find((p) => p.token0.symbol === symbol || p.token1.symbol === symbol) ?? null;
    if (!any) return { price: 1, pair: null };
    if (any.token0.symbol === symbol) return { price: any.priceToken0PerToken1, pair: any };
    return { price: any.priceToken0PerToken1 > 0 ? 1 / any.priceToken0PerToken1 : 1, pair: any };
  }
  // pick candidate whose price looks most USD-like (not absurd)
  const sane = candidates
    .slice()
    .sort((a, b) => b.liquidityUsd - a.liquidityUsd)
    .find((p) => p.priceToken0PerToken1 > 0.0000001 && p.priceToken0PerToken1 < 500000);
  const pick = sane ?? candidates[0];
  return { price: pick.priceToken0PerToken1, pair: pick };
}

function usdPrice(symbol: string, holdings: Holding[] = []): number {
  if (STABLES.has(symbol)) return 1;
  const hold = holdings.find((h) => h.symbol === symbol);
  if (hold && hold.price > 0 && hold.price < 500000) return hold.price;
  return bestPairPrice(symbol).price;
}

function buildDefaultHoldings(): Holding[] {
  const seeds: Array<{ symbol: string; amount: number }> = [
    { symbol: "WETH", amount: 1.25 },
    { symbol: "WBTC", amount: 0.05 },
    { symbol: "USDC", amount: 2500 },
    { symbol: "APE", amount: 1200 },
    { symbol: "SOL", amount: 8.5 },
    { symbol: "MOON", amount: 15000 },
  ];

  return seeds.map((s, i) => {
    const { price, pair } = bestPairPrice(s.symbol);
    const finalPrice = s.symbol === "USDC" ? 1 : price;
    const avgBuy = finalPrice * (0.9 + (i % 3) * 0.03);
    const base: Holding = {
      id: pair?.address ?? `hold-${s.symbol.toLowerCase()}`,
      symbol: s.symbol,
      name: pair?.token0.symbol === s.symbol
        ? pair.token0.name
        : pair?.token1.symbol === s.symbol
          ? pair.token1.name
          : s.symbol,
      amount: 0,
      price: finalPrice,
      valueUsd: 0,
      change24h: pair?.priceChange24h ?? 0,
      pairAddress: pair?.address ?? `hold-${s.symbol.toLowerCase()}`,
      avgBuy,
      pnlUsd: 0,
      pnlPct: 0,
    };
    return recompute(base, s.amount, finalPrice, avgBuy);
  });
}

export default function SwapPage() {
  const [holdings, setHoldings] = useState<Holding[]>(() => buildDefaultHoldings());
  const [fromId, setFromId] = useState(() => buildDefaultHoldings()[0]?.id ?? "");
  const [toSymbol, setToSymbol] = useState("USDC");
  const [amount, setAmount] = useState("");
  const [slippage, setSlippage] = useState("1");
  const [toast, setToast] = useState<string | null>(null);
  const [busy, setBusy] = useState(false);

  useEffect(() => {
    try {
      const saved = localStorage.getItem(PORTFOLIO_KEY);
      if (saved) {
        const h = JSON.parse(saved) as Holding[];
        if (Array.isArray(h) && h.length > 0) {
          setHoldings(h);
          setFromId(h[0].id);
          return;
        }
      }
    } catch {
      // ignore corrupt storage
    }
    const defaults = buildDefaultHoldings();
    setHoldings(defaults);
    setFromId(defaults[0]?.id ?? "");
    try {
      localStorage.setItem(PORTFOLIO_KEY, JSON.stringify(defaults));
    } catch {
      // ignore
    }
  }, []);

  useEffect(() => {
    if (!toast) return;
    const t = setTimeout(() => setToast(null), 2400);
    return () => clearTimeout(t);
  }, [toast]);

  const fromHolding = useMemo(
    () => holdings.find((h) => h.id === fromId) ?? holdings[0] ?? null,
    [holdings, fromId]
  );

  const fromOptions = useMemo(
    () => Array.from(new Map(holdings.map((h) => [h.symbol, h])).values()),
    [holdings]
  );

  const tokenOptions = useMemo(() => {
    const fromHoldings = holdings.map((h) => h.symbol);
    const fromPairs = mockPairs.flatMap((p) => [p.token0.symbol, p.token1.symbol]);
    return Array.from(new Set([...fromHoldings, ...fromPairs, "USDC"])).sort();
  }, [holdings]);

  const srcAmount = Number(amount) || 0;
  const fromPrice = fromHolding ? usdPrice(fromHolding.symbol, holdings) : 0;
  const toPrice = toSymbol ? usdPrice(toSymbol, holdings) : 0;
  const srcValue = srcAmount * fromPrice;
  const rate = fromPrice > 0 && toPrice > 0 ? fromPrice / toPrice : 0;
  const receiveRaw = rate > 0 ? srcAmount * rate : 0;
  const slip = Number(slippage) || 0;
  const receiveMin = receiveRaw * (1 - slip / 100);

  // Avoid selecting same token
  useEffect(() => {
    if (fromHolding && toSymbol === fromHolding.symbol) {
      setToSymbol(fromHolding.symbol === "USDC" ? "WETH" : "USDC");
    }
  }, [fromHolding, toSymbol]);

  const canSwap =
    !!fromHolding &&
    !!toSymbol &&
    srcAmount > 0 &&
    srcAmount <= fromHolding.amount &&
    toSymbol !== fromHolding.symbol &&
    !busy;

  function flip() {
    if (!fromHolding || !toSymbol) return;
    const target = holdings.find((h) => h.symbol === toSymbol);
    const prevFrom = fromHolding.symbol;
    if (target) {
      setFromId(target.id);
    }
    setToSymbol(prevFrom);
    setAmount("");
  }

  function doSwap() {
    if (!canSwap || !fromHolding) return;
    setBusy(true);

    const fromSym = fromHolding.symbol;
    const toSym = toSymbol;
    const outAmt = receiveRaw;
    const outPrice = toPrice;

    let next = holdings.map((h) => {
      if (h.id === fromHolding.id) {
        return recompute(h, Math.max(0, h.amount - srcAmount), h.price, h.avgBuy);
      }
      return h;
    });

    const existingTo = next.find((h) => h.symbol === toSym);
    if (existingTo) {
      const newAmt = existingTo.amount + outAmt;
      const newAvg =
        existingTo.amount + outAmt > 0
          ? (existingTo.avgBuy * existingTo.amount + outPrice * outAmt) / (existingTo.amount + outAmt)
          : outPrice;
      next = next.map((h) =>
        h.id === existingTo.id
          ? recompute(h, newAmt, STABLES.has(toSym) ? 1 : h.price || outPrice, newAvg)
          : h
      );
    } else {
      const pair = mockPairs.find(
        (p) => p.token0.symbol === toSym || p.token1.symbol === toSym
      );
      const id = pair?.address ?? `swap-${toSym.toLowerCase()}`;
      const name =
        pair?.token0.symbol === toSym
          ? pair.token0.name
          : pair?.token1.symbol === toSym
            ? pair.token1.name
            : toSym;
      const base: Holding = {
        id,
        symbol: toSym,
        name,
        amount: 0,
        price: outPrice,
        valueUsd: 0,
        change24h: pair?.priceChange24h ?? 0,
        pairAddress: pair?.address ?? id,
        avgBuy: outPrice,
        pnlUsd: 0,
        pnlPct: 0,
      };
      next = [...next, recompute(base, outAmt, outPrice, outPrice)];
    }

    next = next.filter((h) => h.amount > 1e-10);
    setHoldings(next);
    try {
      localStorage.setItem(PORTFOLIO_KEY, JSON.stringify(next));
    } catch {
      // ignore
    }

    if (!next.find((h) => h.id === fromId) && next[0]) {
      setFromId(next[0].id);
    }
    setAmount("");
    setToast(
      `Swap OK · ${formatNumber(srcAmount, 4)} ${fromSym} → ${formatNumber(outAmt, 4)} ${toSym}`
    );
    setBusy(false);
  }

  return (
    <>
      <Header active="Swap" />
      <main className="w-full flex-1 px-4 py-8 sm:py-10">
        <div className="mx-auto w-full max-w-[560px]">
          <div className="rounded-2xl border border-border bg-card/40 p-6 shadow-sm sm:p-8">
            <div className="mb-3 flex items-center justify-between">
              <span className="text-lg font-semibold">Market Swap</span>
              <span className="rounded border border-border bg-muted/40 px-2 py-1 text-xs text-muted-foreground">
                Arc Testnet · 5042002
              </span>
            </div>

            {/* From */}
            <div className="mb-3 rounded-xl border border-border bg-muted/20 p-4">
              <div className="mb-3 flex items-center justify-between text-sm text-muted-foreground">
                <span>From</span>
                {fromHolding && (
                  <button
                    type="button"
                    onClick={() => setAmount(String(fromHolding.amount))}
                    className="hover:text-foreground cursor-pointer"
                  >
                    Balance:{" "}
                    <span className="font-mono text-foreground">
                      {formatNumber(fromHolding.amount, 4)}
                    </span>{" "}
                    · MAX
                  </button>
                )}
              </div>
              <div className="flex items-center gap-2">
                <input
                  type="number"
                  min="0"
                  step="any"
                  value={amount}
                  onChange={(e) => setAmount(e.target.value)}
                  placeholder="0.00"
                  className="min-w-0 flex-1 bg-transparent text-4xl font-mono font-semibold outline-none"
                />
                <select
                  value={fromHolding?.id ?? ""}
                  onChange={(e) => {
                    setFromId(e.target.value);
                    setAmount("");
                  }}
                  className="max-w-[160px] rounded-xl border border-border bg-background px-3 py-3 text-base font-semibold outline-none focus:border-emerald-500/50"
                >
                  {fromOptions.length === 0 && <option value="">— kosong —</option>}
                  {fromOptions.map((h) => (
                    <option key={h.id} value={h.id}>
                      {h.symbol}
                    </option>
                  ))}
                </select>
              </div>
              {fromHolding && srcAmount > 0 && (
                <div className="mt-2 text-sm text-muted-foreground">
                  ≈ {formatUsd(srcValue)}
                  {srcAmount > fromHolding.amount && (
                    <span className="ml-2 text-red-400">Melebihi balance</span>
                  )}
                </div>
              )}
            </div>

            {/* Flip */}
            <div className="relative z-10 -my-1 flex justify-center">
              <button
                type="button"
                onClick={flip}
                className="flex h-11 w-11 items-center justify-center rounded-full border border-border bg-background text-muted-foreground hover:border-emerald-500/50 hover:text-emerald-400 cursor-pointer"
                title="Flip"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2">
                  <path d="M7 10V3M7 3L4 6M7 3l3 3" />
                  <path d="M17 14v7M17 21l3-3M17 21l-3-3" />
                </svg>
              </button>
            </div>

            {/* To */}
            <div className="mb-4 rounded-xl border border-border bg-muted/20 p-4">
              <div className="mb-3 flex items-center justify-between text-sm text-muted-foreground">
                <span>To</span>
                {toSymbol && (
                  <span>
                    Price{" "}
                    <span className="font-mono text-foreground">
                      {formatPrice(toPrice)}
                    </span>
                  </span>
                )}
              </div>
              <div className="flex items-center gap-2">
                <div className="min-w-0 flex-1 text-4xl font-mono font-semibold text-foreground">
                  {toSymbol && srcAmount > 0 ? formatNumber(receiveRaw, 6) : "0.00"}
                </div>
                <select
                  value={toSymbol}
                  onChange={(e) => setToSymbol(e.target.value)}
                  className="max-w-[160px] rounded-xl border border-border bg-background px-3 py-3 text-base font-semibold outline-none focus:border-emerald-500/50"
                >
                  <option value="">Pilih token</option>
                  {tokenOptions
                    .filter((s) => s !== fromHolding?.symbol)
                    .map((s) => (
                      <option key={s} value={s}>
                        {s}
                      </option>
                    ))}
                </select>
              </div>
              {toSymbol && srcAmount > 0 && (
                <div className="mt-2 text-sm text-muted-foreground">
                  Min receive ({slippage}% slip):{" "}
                  <span className="font-mono text-blue-400">
                    {formatNumber(receiveMin, 6)} {toSymbol}
                  </span>
                </div>
              )}
            </div>

            {/* Slippage */}
            <div className="mb-4">
              <div className="mb-2 flex items-center justify-between text-sm text-muted-foreground">
                <span>Slippage</span>
                <span>{slippage}%</span>
              </div>
              <div className="flex gap-1">
                {["0.5", "1", "2", "5"].map((v) => (
                  <button
                    key={v}
                    type="button"
                    onClick={() => setSlippage(v)}
                    className={`flex-1 rounded-lg px-3 py-2.5 text-sm font-medium cursor-pointer ${
                      slippage === v
                        ? "bg-foreground text-background"
                        : "bg-muted/50 text-muted-foreground hover:text-foreground"
                    }`}
                  >
                    {v}%
                  </button>
                ))}
              </div>
            </div>

            {/* Rate box */}
            {fromHolding && toSymbol && rate > 0 && (
              <div className="mb-5 space-y-2 rounded-xl border border-border bg-muted/20 px-4 py-3 text-sm text-muted-foreground">
                <div className="flex justify-between">
                  <span>Rate</span>
                  <span className="font-mono text-foreground">
                    1 {fromHolding.symbol} ≈ {formatNumber(rate, 6)} {toSymbol}
                  </span>
                </div>
                <div className="flex justify-between">
                  <span>Value</span>
                  <span className="font-mono text-emerald-400">{formatUsd(srcValue)}</span>
                </div>
                <div className="flex justify-between">
                  <span>Network</span>
                  <span className="text-foreground">Arc Testnet (5042002)</span>
                </div>
              </div>
            )}

            <button
              type="button"
              disabled={!canSwap}
              onClick={doSwap}
              className={`w-full rounded-xl py-4 text-base font-semibold cursor-pointer transition-colors ${
                canSwap
                  ? "bg-blue-500 text-white hover:bg-blue-400"
                  : "bg-muted/40 text-muted-foreground cursor-not-allowed"
              }`}
            >
              {busy
                ? "Swapping..."
                : !fromHolding
                  ? "Tidak ada balance"
                  : !toSymbol
                    ? "Pilih token tujuan"
                    : srcAmount <= 0
                      ? "Masukkan amount"
                      : srcAmount > fromHolding.amount
                        ? "Amount melebihi balance"
                        : `Swap ${fromHolding.symbol} → ${toSymbol}`}
            </button>
          </div>

          {toast && (
            <div className="mt-3 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-3 py-2 text-center text-xs text-emerald-300">
              {toast}
            </div>
          )}
        </div>
      </main>
      <Footer />
    </>
  );
}
